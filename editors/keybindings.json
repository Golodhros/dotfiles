// Shared keybindings for Cursor and VS Code (symlinked into both by install.sh).
// Bindings for commands that only exist in one editor are ignored by the other.
[
  {
    "key": "ctrl+l",
    "command": "aichat.newchataction"
  },
  {
    "key": "cmd+l",
    "command": "expandLineSelection"
  },
  {
    "key": "cmd+k cmd+w",
    "command": "workbench.action.closeAllEditors"
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent"
  }
]
