{
    "editor.fontLigatures": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.formatOnSave": true,
    "editor.accessibilitySupport": "off",
    "editor.formatOnPaste": true,
    "editor.inlineSuggest.enabled": true,
    "window.autoDetectColorScheme": true,
    "workbench.preferredLightColorTheme": "Monokai Pro (Filter Ristretto)",
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "eslint.workingDirectories": [
        {
            "mode": "auto"
        }
    ],
    "eslint.options": {},
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "workbench.colorCustomizations": {
        "editor.findMatchHighlightBackground": "#ff00c3a7", //Other SEARCH MATCHES
        "editor.selectionBackground": "#e37933",
        "editor.findMatchBackground": "#e37933" //Current SEARCH MATCH
    },
    "workbench.editor.showTabs": "multiple",
    "[javascript]": {
        "editor.formatOnSave": true
    },
    "[json]": {
        "editor.formatOnSave": true,
    },
    "[javascriptreact]": {
        "editor.formatOnSave": true,
    },
    "[typescript]": {
        "editor.formatOnSave": true
    },
    "[typescriptreact]": {
        "editor.formatOnSave": true
    },
    "[sass]": {
        "editor.formatOnSave": true
    },
    "[scss]": {
        "editor.formatOnSave": true
    },
    "[go]": {
        "editor.formatOnSave": true
    },
    "[jsonc]": {},
    "[yaml]": {
        "editor.formatOnSave": false
    },
    "[markdown]": {
        "editor.formatOnSave": false
    },
    "[html]": {},
    "[python]": {
        "editor.formatOnType": true
    },
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "trailing-spaces.trimOnSave": true,
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "http.systemCertificates": false,
    "files.associations": {
        "*.tsx": "typescriptreact",
        ".env*": "makefile"
    },
    "files.insertFinalNewline": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "window.zoomLevel": 1,
    "git.openRepositoryInParentFolders": "never",
    "colorize.languages": [
        "javascript",
        "typescript",
        "typescriptreact"
    ],
    "gitlens.advanced.messages": {
        "suppressRebaseSwitchToTextWarning": true
    },
    "peacock.favoriteColors": [
        {
            "name": "Angular Red",
            "value": "#dd0531"
        },
        {
            "name": "Azure Blue",
            "value": "#007fff"
        },
        {
            "name": "JavaScript Yellow",
            "value": "#f9e64f"
        },
        {
            "name": "Mandalorian Blue",
            "value": "#1857a4"
        },
        {
            "name": "Node Green",
            "value": "#215732"
        },
        {
            "name": "React Blue",
            "value": "#61dafb"
        },
        {
            "name": "Something Different",
            "value": "#832561"
        },
        {
            "name": "Svelte Orange",
            "value": "#ff3d00"
        },
        {
            "name": "Vue Green",
            "value": "#42b883"
        }
    ],
    "workbench.editor.enablePreview": false,
    "gitlens.statusBar.enabled": false,
    "gitlens.statusBar.pullRequests.enabled": false,
    "gitlens.statusBar.reduceFlicker": false,
    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.hideUnchangedRegions.enabled": true,
}
